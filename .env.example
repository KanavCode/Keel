# --- Gemini API (free tier). Serves Gemma 4. Get a key at https://aistudio.google.com/apikey ---
GEMINI_API_KEY=
KEEL_MODEL=gemma-4-26b-a4b-it
# KEEL_RPM=12            # requests per minute throttle (free tier is roughly 15)
# KEEL_THINKING=minimal  # Gemma 4 thinking level: minimal | high

# --- Or any OpenAI-compatible server (DigitalOcean Gradient, Ollama, vLLM) ---
# KEEL_PROVIDER=openai
# KEEL_BASE_URL=https://inference.do-ai.run/v1
# KEEL_API_KEY=your-model-access-key
# KEEL_MODEL=llama3.3-70b-instruct
# Local Ollama: KEEL_BASE_URL=http://localhost:11434/v1  KEEL_MODEL=gemma3
